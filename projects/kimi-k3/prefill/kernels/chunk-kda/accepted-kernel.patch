+@triton.jit
+def _kda_prepare_tile(
+    x,
+    y,
+    stride_x_t,
+    stride_y_t,
+    eps,
+    i_t,
+    T,
+    D: tl.constexpr,
+    BT: tl.constexpr,
+    BD: tl.constexpr,
+    NORMALIZE: tl.constexpr,
+):
+    """One (BT, BD) tile of one head: optional L2 normalization, then store.
+
+    Block shape, reduction axis, FP32 accumulation and the divide-by-sqrt form
+    match l2norm_fwd_kernel, and each row is normalized independently, so the
+    per-head tiling here is mathematically equivalent to that kernel's flattened
+    (T*H, D) tiling. Only the input pointer arithmetic differs (explicit token
+    stride instead of a contiguous flattened view).
+
+    Matching block dimensions do not by themselves guarantee an identical compiler
+    reduction for every accepted specialization, so this is an equivalence claim
+    checked against the frozen tolerance, not a bitwise guarantee.
+    """
+    # int64 strides: the token offset reaches i_t * BT * stride_t, which overflows
+    # int32 for large token strides even at modest T. tl.cast, not .to(): the
+    # output stride arrives as a constexpr expression (H * DK), and constexpr has
+    # no .to method, while tl.cast accepts constexpr and runtime scalars alike.
+    p_x = tl.make_block_ptr(
+        x, (T, D), (tl.cast(stride_x_t, tl.int64), 1), (i_t * BT, 0), (BT, BD), (1, 0)
+    )
+    p_y = tl.make_block_ptr(
+        y, (T, D), (tl.cast(stride_y_t, tl.int64), 1), (i_t * BT, 0), (BT, BD), (1, 0)
+    )
+    b_x = tl.load(p_x, boundary_check=(0, 1))
+    if NORMALIZE:
+        b_f = b_x.to(tl.float32)
+        b_var = tl.sum(b_f * b_f, axis=1)
+        b_y = b_f / tl.sqrt(b_var + eps)[:, None]
+        tl.store(p_y, b_y.to(p_y.dtype.element_ty), boundary_check=(0, 1))
+    else:
+        tl.store(p_y, b_x, boundary_check=(0, 1))
+
+
+@triton.jit(do_not_specialize=["T"])
+def kda_prepare_qkv_fwd_kernel(
+    q,
+    k,
+    v,
+    q_out,
+    k_out,
+    v_out,
+    eps,
+    T,
+    stride_q_b,
+    stride_q_t,
+    stride_q_h,
+    stride_k_b,
+    stride_k_t,
+    stride_k_h,
+    stride_v_b,
+    stride_v_t,
+    stride_v_h,
+    H: tl.constexpr,
+    DK: tl.constexpr,
+    DV: tl.constexpr,
+    BT: tl.constexpr,
+    BDK: tl.constexpr,
+    BDV: tl.constexpr,
+):
+    """Materialize strided packed Q/K/V and L2-normalize Q/K in one launch.
+
+    Grid is (token blocks, B*H, 3); the third axis picks Q, K or V so all three
+    tensors share one launch instead of one copy plus one normalization each.
+    """
+    i_t, i_bh, i_tensor = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    i_b, i_h = i_bh // H, i_bh % H
+    # Widen the indices BEFORE multiplying. Casting only the batch index leaves
+    # i_h * stride_h as an int32 product, which wraps for large head strides
+    # (envelope-strided or page-major views) and reads outside the allocation.
+    i_b64, i_h64 = i_b.to(tl.int64), i_h.to(tl.int64)
+    head_rows = (i_b64 * T) * H + i_h64
+    if i_tensor == 0:
+        _kda_prepare_tile(
+            q + i_b64 * stride_q_b + i_h64 * stride_q_h,
+            q_out + head_rows * DK,
+            stride_q_t,
+            H * DK,
+            eps,
+            i_t,
+            T,
+            DK,
+            BT,
+            BDK,
+            True,
+        )
+    elif i_tensor == 1:
+        _kda_prepare_tile(
+            k + i_b64 * stride_k_b + i_h64 * stride_k_h,
+            k_out + head_rows * DK,
+            stride_k_t,
+            H * DK,
+            eps,
+            i_t,
+            T,
+            DK,
+            BT,
+            BDK,
+            True,
+        )
+    else:
+        _kda_prepare_tile(
+            v + i_b64 * stride_v_b + i_h64 * stride_v_h,
+            v_out + head_rows * DV,
+            stride_v_t,
+            H * DV,
+            eps,
+            i_t,
+            T,
+            DV,
+            BT,
+            BDV,
+            False,
+        )
+
