+def kda_prepare_qkv_fwd(
+    q: torch.Tensor, k: torch.Tensor, v: torch.Tensor, eps: float = 1e-6
+):
+    """L2-normalize Q/K and materialize a contiguous V in one launch.
+
+    Replaces `l2norm_fwd(q.contiguous())`, `l2norm_fwd(k.contiguous())` and
+    `v.contiguous()`. `l2norm_fwd` allocates its own output, so the Q/K copies
+    only existed to satisfy its flattened view.
+
+    An already-contiguous `v` is returned unchanged, never copied:
+    `chunk_gla_fwd_o_gk(o=v)` writes the operator result through this buffer, so
+    copying would stop the caller's tensor from receiving the output and would
+    break the returned-output aliasing that `v.contiguous()` gave for free.
+    """
+    supported = (
+        q.ndim == 4
+        and k.shape == q.shape
+        and v.ndim == 4
+        and v.shape[:3] == q.shape[:3]
+        and q.dtype == k.dtype == v.dtype
+        and q.device == k.device == v.device
+        and q.stride(-1) == k.stride(-1) == v.stride(-1) == 1
+        # l2norm_fwd dispatches to l2norm_fwd_kernel only below 512; stay inside
+        # that range so the normalization math matches the old path.
+        and q.shape[-1] <= 512
+        and v.shape[-1] <= 512
+    )
+    if not supported:
+        return l2norm_fwd(q.contiguous(), eps), l2norm_fwd(k.contiguous(), eps), v.contiguous()
+
+    B, T, H, DK = q.shape
+    DV = v.shape[-1]
+    q_out = torch.empty(q.shape, dtype=q.dtype, device=q.device)
+    k_out = torch.empty(k.shape, dtype=k.dtype, device=k.device)
+    materialize_v = not v.is_contiguous()
+    v_out = torch.empty(v.shape, dtype=v.dtype, device=v.device) if materialize_v else v
+    BT = 16
+    # Grid z selects Q, K or V; it drops to 2 when V needs no materialization.
+    kda_prepare_qkv_fwd_kernel[(triton.cdiv(T, BT), B * H, 3 if materialize_v else 2)](
+        q,
+        k,
+        v,
+        q_out,
+        k_out,
+        v_out,
+        eps,
+        T=T,
+        stride_q_b=q.stride(0),
+        stride_q_t=q.stride(1),
+        stride_q_h=q.stride(2),
+        stride_k_b=k.stride(0),
+        stride_k_t=k.stride(1),
+        stride_k_h=k.stride(2),
+        stride_v_b=v.stride(0),
+        stride_v_t=v.stride(1),
+        stride_v_h=v.stride(2),
+        H=H,
+        DK=DK,
+        DV=DV,
+        BT=BT,
+        BDK=triton.next_power_of_2(DK),
+        BDV=triton.next_power_of_2(DV),
+        num_warps=8,
+        num_stages=3,
+    )
+    return q_out, k_out, v_out
+
